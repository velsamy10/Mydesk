{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.trading/nifty-intraday-pro/option-chain-data-schema-1.0.json",
  "title": "NIFTY Intraday Pro – External Option Chain Payload",
  "description": "Contract between external_option_chain_service.py and the TradingView Pine bridge. Pine cannot fetch this file; the trader or an OS helper copies bridge fields into indicator inputs. Never hard-code example_payload into production Pine as live data.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "symbol",
    "expiry",
    "expiry_yymmdd",
    "spot",
    "atm_strike",
    "strike_interval",
    "strike_range",
    "chain_timestamp",
    "fetched_at",
    "freshness",
    "usable_for_signals",
    "strikes",
    "aggregates",
    "bridge"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "status": { "type": "string", "enum": ["ok", "partial", "error"] },
    "message": { "type": ["string", "null"] },
    "symbol": { "type": "string", "enum": ["NIFTY", "BANKNIFTY", "FINNIFTY", "MIDCPNIFTY"] },
    "expiry": { "type": "string", "description": "NSE expiryDates format, e.g. 17-Nov-2026" },
    "expiry_yymmdd": { "type": "string", "pattern": "^[0-9]{6}$", "description": "TradingView option ticker expiry segment" },
    "spot": { "type": ["number", "null"] },
    "atm_strike": { "type": ["number", "null"] },
    "strike_interval": { "type": "number", "exclusiveMinimum": 0 },
    "strike_range": { "type": "integer", "enum": [3, 5, 10], "description": "ATM ± N strikes" },
    "chain_timestamp": { "type": ["string", "null"], "description": "NSE records.timestamp" },
    "fetched_at": { "type": "string", "description": "ISO-8601 local time when this file was written" },
    "freshness": { "type": "string", "enum": ["fresh", "stale", "unknown"] },
    "max_stale_seconds": { "type": "integer", "minimum": 60 },
    "usable_for_signals": { "type": "boolean" },
    "source": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "endpoints": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "previous_snapshot": {
      "type": "object",
      "properties": {
        "available": { "type": "boolean" },
        "fetched_at": { "type": ["string", "null"] },
        "chain_timestamp": { "type": ["string", "null"] }
      }
    },
    "strikes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["strike", "ce_oi", "pe_oi", "ce_ltp", "pe_ltp"],
        "properties": {
          "strike": { "type": "number" },
          "ce_oi": { "type": ["integer", "null"] },
          "pe_oi": { "type": ["integer", "null"] },
          "ce_chg_day": { "type": ["integer", "null"], "description": "NSE changeinOpenInterest for the session" },
          "pe_chg_day": { "type": ["integer", "null"] },
          "ce_chg_snap": { "type": ["integer", "null"], "description": "OI delta vs previous local snapshot" },
          "pe_chg_snap": { "type": ["integer", "null"] },
          "ce_ltp": { "type": ["number", "null"] },
          "pe_ltp": { "type": ["number", "null"] },
          "ce_ltp_chg_snap": { "type": ["number", "null"] },
          "pe_ltp_chg_snap": { "type": ["number", "null"] },
          "ce_bid": { "type": ["number", "null"] },
          "ce_ask": { "type": ["number", "null"] },
          "ce_bid_qty": { "type": ["integer", "null"] },
          "ce_ask_qty": { "type": ["integer", "null"] },
          "ce_spread": { "type": ["number", "null"] },
          "ce_spread_pct": { "type": ["number", "null"] },
          "ce_depth_imbalance": { "type": ["number", "null"], "description": "(bid_qty-ask_qty)/(bid+ask); + = more bid" },
          "ce_moneyness": { "type": ["string", "null"], "enum": ["ITM", "ATM", "OTM", null] },
          "ce_liquidity": { "type": ["string", "null"], "enum": ["ok", "thin", "poor", "unknown", null] },
          "pe_bid": { "type": ["number", "null"] },
          "pe_ask": { "type": ["number", "null"] },
          "pe_bid_qty": { "type": ["integer", "null"] },
          "pe_ask_qty": { "type": ["integer", "null"] },
          "pe_spread": { "type": ["number", "null"] },
          "pe_spread_pct": { "type": ["number", "null"] },
          "pe_depth_imbalance": { "type": ["number", "null"] },
          "pe_moneyness": { "type": ["string", "null"], "enum": ["ITM", "ATM", "OTM", null] },
          "pe_liquidity": { "type": ["string", "null"], "enum": ["ok", "thin", "poor", "unknown", null] }
        }
      }
    },
    "liquidity": {
      "type": "object",
      "description": "ATM + nearest ITM bid/ask depth and spread summary for entry/exit cost",
      "properties": {
        "atm_ce": { "type": ["object", "null"] },
        "atm_pe": { "type": ["object", "null"] },
        "nearest_itm_ce": { "type": ["object", "null"] },
        "nearest_itm_pe": { "type": ["object", "null"] },
        "band_poor_ce": { "type": "integer" },
        "band_poor_pe": { "type": "integer" },
        "note": { "type": "string" }
      }
    },
    "aggregates": {
      "type": "object",
      "required": [
        "total_ce_oi",
        "total_pe_oi",
        "pcr",
        "ce_chg_oi",
        "pe_chg_oi",
        "pcr_direction"
      ],
      "properties": {
        "strike_count_expected": { "type": "integer" },
        "strike_count_actual": { "type": "integer" },
        "missing_strikes": { "type": "array", "items": { "type": "number" } },
        "total_ce_oi": { "type": ["integer", "null"] },
        "total_pe_oi": { "type": ["integer", "null"] },
        "pcr": { "type": ["number", "null"] },
        "pcr_prev": { "type": ["number", "null"] },
        "pcr_chg": { "type": ["number", "null"] },
        "pcr_direction": { "type": "string", "enum": ["rising", "falling", "sideways", "unknown"] },
        "ce_chg_oi": { "type": ["integer", "null"], "description": "Sum of ce_chg_snap across band" },
        "pe_chg_oi": { "type": ["integer", "null"] },
        "ce_chg_oi_pct": { "type": ["number", "null"] },
        "pe_chg_oi_pct": { "type": ["number", "null"] },
        "ce_chg_day_total": { "type": ["integer", "null"] },
        "pe_chg_day_total": { "type": ["integer", "null"] },
        "max_ce_oi_strike": { "type": ["number", "null"] },
        "max_pe_oi_strike": { "type": ["number", "null"] }
      }
    },
    "bridge": {
      "type": "object",
      "description": "Compact fields intended for Pine input.* paste. Updated every successful fetch.",
      "properties": {
        "pcr": { "type": ["number", "null"] },
        "pcr_direction": { "type": "string" },
        "ce_chg_oi": { "type": ["integer", "null"] },
        "pe_chg_oi": { "type": ["integer", "null"] },
        "ce_chg_oi_pct": { "type": ["number", "null"] },
        "pe_chg_oi_pct": { "type": ["number", "null"] },
        "atm_strike": { "type": ["number", "null"] },
        "spot": { "type": ["number", "null"] },
        "freshness": { "type": "string" },
        "usable_for_signals": { "type": "boolean" },
        "chain_timestamp": { "type": ["string", "null"] },
        "paste_line": { "type": "string", "description": "Single line for quick paste into a Pine text input" }
      }
    }
  },
